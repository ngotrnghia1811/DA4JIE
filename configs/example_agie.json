{
  "_comment": "Configuration for AGIE (DA4JIE) with domain adaptation on ACE 2005-E+.",
  "model_type": "agie",

  "bert_model_name": "bert-large-cased",
  "bert_cache_dir": "<BERT_CACHE_DIR>",
  "multi_piece_strategy": "first",
  "bert_dropout": 0.5,
  "use_extra_bert": false,
  "extra_bert": -1,

  "linear_dropout": 0.4,
  "linear_bias": true,
  "use_entity_type": true,
  "relation_mask_self": true,
  "relation_directional": false,
  "symmetric_relations": ["PER-SOC"],

  "gcn_config": {
    "num_layers": 2,
    "skip_connection": true,
    "anneal": false
  },
  "gcn_drop": 0.3,
  "task_embed_dim": 32,
  "type_embed_dim": 150,

  "dom_emb_type": ["ace", "acm", "dblp", "imdb"],
  "dom_emb_size": [32, 32],

  "gtn": {
    "num_edge": 2,
    "num_channels": 2,
    "num_layers": 1,
    "norm": true
  },

  "grda": {
    "device": "cuda:0",
    "batch_size": 10,
    "num_domain": 4,
    "num_sample_d": 3,
    "num_sample_g": 3,
    "grda_lambda": 0.01,
    "dom_adj_matrix": [[1,1,0,0],[1,1,0,0],[0,0,1,1],[0,0,1,1]],
    "Ddim": [128, 64, 1],
    "Gdim": [32, 32, 32]
  },

  "train_file": "<TRAIN_FILE_PATH>",
  "unlabeled_file": "<UNLABELED_TARGET_FILE>",
  "dev_file": "<DEV_FILE_PATH>",
  "test_file": "<TEST_FILE_PATH>",
  "log_path": "<OUTPUT_DIR>",
  "valid_pattern_path": "<VALID_PATTERN_DIR>",
  "ignore_title": false,
  "ignore_first_header": false,

  "accumulate_step": 1,
  "batch_size": 10,
  "eval_batch_size": 10,
  "max_epoch": 60,
  "learning_rate": 1e-3,
  "bert_learning_rate": 1e-5,
  "weight_decay": 1e-3,
  "bert_weight_decay": 1e-5,
  "warmup_epoch": 5,
  "grad_clipping": 5.0,

  "use_gpu": true,
  "gpu_device": 0
}
